meta {
  name: Encurtar URL com expiração
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/shorten
  body: json
  auth: none
}

body:json {
  {
    "originalUrl": "https://docs.spring.io",
    "expiresAt": "{{expiresAt}}"
  }
}

script:pre-request {
  // LocalDateTime no backend: ISO sem fuso. Daqui a 7 dias.
  const in7Days = new Date(Date.now() + 7 * 24 * 60 * 60 * 1000);
  bru.setVar("expiresAt", in7Days.toISOString().slice(0, 19));
}

tests {
  test("retorna 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("devolve o expiresAt enviado", function () {
    expect(res.body.expiresAt).to.contain(bru.getVar("expiresAt"));
  });
}
