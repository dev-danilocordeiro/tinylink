meta {
  name: Encurtar URL com expiração
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/shorten
  body: json
  auth: none
}

body:json {
  {
    "originalUrl": "https://docs.spring.io",
    "expiresAt": "{{expiresAt}}"
  }
}

script:pre-request {
  // O backend exige data com fuso (Instant). toISOString() manda em UTC, com "Z". Daqui a 7 dias.
  const in7Days = new Date(Date.now() + 7 * 24 * 60 * 60 * 1000);
  bru.setVar("expiresAt", in7Days.toISOString());
}

tests {
  test("retorna 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("devolve o mesmo instante enviado em expiresAt", function () {
    expect(new Date(res.body.expiresAt).getTime()).to.equal(new Date(bru.getVar("expiresAt")).getTime());
  });
}
