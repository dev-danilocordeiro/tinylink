meta {
  name: Alias duplicado
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/shorten
  body: json
  auth: none
}

body:json {
  {
    "originalUrl": "https://example.com",
    "customAlias": "{{aliasCode}}"
  }
}

tests {
  test("retorna 409", function () {
    expect(res.getStatus()).to.equal(409);
  });

  test("responde com ProblemDetail explicando que o alias já existe", function () {
    expect(res.getHeader("content-type")).to.contain("application/problem+json");
    expect(res.body.title).to.equal("Alias already exists");
    expect(res.body.alias).to.equal(bru.getVar("aliasCode"));
  });
}

docs {
  Depende de **Encurtar URL com alias** ter rodado antes.
}
