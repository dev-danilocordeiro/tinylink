meta {
  name: Deletar código inexistente
  type: http
  seq: 17
}

delete {
  url: {{baseUrl}}/api/naoexiste123
  body: none
  auth: none
}

tests {
  test("retorna 404", function () {
    expect(res.getStatus()).to.equal(404);
  });

  test("responde com ProblemDetail explicando que o código não existe", function () {
    expect(res.getHeader("content-type")).to.contain("application/problem+json");
    expect(res.body.title).to.equal("Short code not found");
    expect(res.body.shortCode).to.equal("naoexiste123");
  });
}
