meta {
  name: Criar link já expirado
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/shorten
  body: json
  auth: none
}

body:json {
  {
    "originalUrl": "https://example.com/expirado",
    "expiresAt": "{{expiredAt}}"
  }
}

script:pre-request {
  const yesterday = new Date(Date.now() - 24 * 60 * 60 * 1000);
  bru.setVar("expiredAt", yesterday.toISOString());
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setVar("expiredCode", res.body.shortCode);
  }
}

tests {
  test("retorna 200 (a API não rejeita expiresAt no passado)", function () {
    expect(res.getStatus()).to.equal(200);
  });
}
